<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resources — {{.SiteName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
    <script src="js/nav.js" defer></script>

    <script src="js/ask.js" defer></script>
    {{template "head-og" .}}
</head>
<body>

    {{template "nav" .}}

    <main class="resources-page">
        <h1>Resources</h1>
        <p>A curated collection of resources to help you learn and share information about bodily autonomy and genital integrity.</p>

        <div class="get-involved-nav">
            <a href="#ask-curated-ai" class="get-involved-nav-link">Ask the Knowledge Base</a>
            <a href="#key-facts" class="get-involved-nav-link">Key Facts</a>
            <a href="#youtube-shorts" class="get-involved-nav-link">YouTube Shorts</a>
        </div>

        <section class="resource-section" id="ask-curated-ai">
            <h2>Ask the Knowledge Base</h2>
            <p>Ask a question and get an answer grounded in content from the organisations featured on this site — no outside knowledge, no hallucination.</p>
            <form class="prompt-form" action="/ask" method="get">
                <div class="prompt-input-wrapper">
                    <input type="text" class="prompt-input" name="q" placeholder="What is genital cutting?" autocomplete="off" />
                    <button type="submit" class="prompt-submit">Ask the Knowledge Base</button>
                </div>
            </form>
            <div id="ask-response" class="ask-response"></div>
        </section>

        <section class="resource-section" id="key-facts">
            <h2>Key Facts</h2>
            <p>A concise, evidence-based overview of what genital cutting is, why it happens, and what the medical and ethical arguments against it are. A good starting point for anyone new to the topic.</p>
            <a href="https://www.intactglobal.org/about/facts" target="_blank" class="resource-link-btn">Read the facts from Intact Global</a>
        </section>

        <section class="resource-section" id="youtube-shorts">
            <h2>YouTube Informational Shorts</h2>
            {{if .Resources}}
            <p class="resource-count">{{len .Resources}} shorts available</p>
            <div class="resource-grid">
                {{range .Resources}}
                <a class="resource-card" href="https://www.youtube.com/shorts/{{.VideoID}}" target="_blank">
                    <img
                        src="https://img.youtube.com/vi/{{.VideoID}}/hqdefault.jpg"
                        alt="{{.Title}}"
                        class="resource-thumbnail"
                    />
                    <div class="resource-info">
                        <h3>{{.Title}}</h3>
                    </div>
                </a>
                {{end}}
            </div>
            {{else}}
            <p class="resource-empty">No resources available yet. Run <code>./gacli harvest</code> with a <code>{{.ProjectPrefix}}_YT_API_KEY</code> set to populate this page.</p>
            {{end}}
        </section>


        <a href="#" class="back-to-top">&#8679; Top</a>
    </main>

    {{template "footer" .}}

</body>
</html>
