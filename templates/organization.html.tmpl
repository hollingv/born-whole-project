{{define "organization-card"}}
<article class="organization-card">
    {{if .Thumbnail}}
    <a href="{{.Website}}" target="_blank" class="org-thumbnail-link">
        <img class="org-thumbnail" src="{{.Thumbnail}}" alt="{{.Name}}" />
    </a>
    {{end}}
    <div class="org-body">
        <h3>{{.Name}}</h3>
        <p>{{.Description}}</p>
    </div>
    <div class="org-nav">
        <a href="{{.Website}}" target="_blank" class="org-link">Visit Site</a>
        {{if .NewsUrl}}<a href="{{.NewsUrl}}" class="org-link">News</a>{{else}}<span class="org-link org-link--disabled">News</span>{{end}}
        {{if .EventsUrl}}<a href="{{.EventsUrl}}" class="org-link">Events</a>{{else}}<span class="org-link org-link--disabled">Events</span>{{end}}
        {{if .DonateUrl}}<a href="{{.DonateUrl}}" target="_blank" class="org-link">Donate</a>{{else}}<span class="org-link org-link--disabled">Donate</span>{{end}}
        {{if .ContactUsUrl}}<a href="{{.ContactUsUrl}}" target="_blank" class="org-link">Contact Us</a>{{else}}<span class="org-link org-link--disabled">Contact Us</span>{{end}}
        <span class="org-link org-link--disabled">TBD</span>
    </div>
    <div class="org-social">
        {{if .SocialSites.Facebook}}<a href="{{.SocialSites.Facebook}}" target="_blank" class="org-social-link" title="Facebook"><img src="images/social-facebook.svg" alt="Facebook" class="org-social-icon"/></a>{{else}}<span class="org-social-link org-social--disabled" title="Facebook"><img src="images/social-facebook.svg" alt="Facebook" class="org-social-icon"/></span>{{end}}
        {{if .SocialSites.X}}<a href="{{.SocialSites.X}}" target="_blank" class="org-social-link" title="X"><img src="images/social-x.svg" alt="X" class="org-social-icon"/></a>{{else}}<span class="org-social-link org-social--disabled" title="X"><img src="images/social-x.svg" alt="X" class="org-social-icon"/></span>{{end}}
        {{if .SocialSites.Instagram}}<a href="{{.SocialSites.Instagram}}" target="_blank" class="org-social-link" title="Instagram"><img src="images/social-instagram.svg" alt="Instagram" class="org-social-icon"/></a>{{else}}<span class="org-social-link org-social--disabled" title="Instagram"><img src="images/social-instagram.svg" alt="Instagram" class="org-social-icon"/></span>{{end}}
        {{if .SocialSites.YouTube}}<a href="{{.SocialSites.YouTube}}" target="_blank" class="org-social-link" title="YouTube"><img src="images/social-youtube.svg" alt="YouTube" class="org-social-icon"/></a>{{else}}<span class="org-social-link org-social--disabled" title="YouTube"><img src="images/social-youtube.svg" alt="YouTube" class="org-social-icon"/></span>{{end}}
    </div>
</article>
{{end}}
