<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouTube Shorts — {{.SiteName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
    <script src="js/nav.js" defer></script>
    <script src="js/youtube-shorts.js" defer></script>
    {{template "head-og" .}}
</head>
<body>

    {{template "nav" .}}

    <main class="resources-page">
        <h1>YouTube Informational Shorts</h1>
        <p>A curated collection of short videos to help you learn and share information about bodily autonomy and genital integrity.</p>

        <section class="resource-section">
            {{if .Resources}}
            <div class="resource-toolbar">
                <p class="resource-count">{{len .Resources}} shorts available</p>
                <div class="view-toggle" role="group" aria-label="View mode">
                    <button class="view-btn view-btn--active" id="btn-grid" aria-pressed="true" aria-label="Grid view" title="Grid view">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                            <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                        </svg>
                    </button>
                    <button class="view-btn" id="btn-list" aria-pressed="false" aria-label="List view" title="List view">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                            <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="resource-grid" id="view-grid">
                {{range .Resources}}
                <a class="resource-card" href="https://www.youtube.com/shorts/{{.VideoID}}" target="_blank">
                    <img
                        src="https://img.youtube.com/vi/{{.VideoID}}/hqdefault.jpg"
                        alt="{{.Title}}"
                        class="resource-thumbnail"
                    />
                    <div class="resource-info">
                        <h3>{{.Title}}</h3>
                    </div>
                </a>
                {{end}}
            </div>

            <div class="resource-list" id="view-list" hidden>
                {{range .Resources}}
                <div class="resource-list-item">
                    <p><a href="https://www.youtube.com/shorts/{{.VideoID}}" target="_blank"><img src="https://img.youtube.com/vi/{{.VideoID}}/hqdefault.jpg" alt="" width="72" height="40" style="vertical-align:middle;margin-right:0.5rem;"/></a>{{.Title}}{{if .Transcript}}&nbsp;<button class="expand-btn" aria-expanded="false">+</button>{{end}}</p>
                    {{if .Transcript}}<div class="resource-transcript" hidden>{{.Transcript}}</div>{{end}}
                </div>
                {{end}}
            </div>
            {{else}}
            <p class="resource-empty">No shorts available yet. Run <code>./bwctl harvest</code> with a <code>{{.ProjectPrefix}}_YT_API_KEY</code> set to populate this page.</p>
            {{end}}
        </section>

        <a href="#" class="back-to-top">&#8679; Top</a>
    </main>

    {{template "footer" .}}

</body>
</html>
