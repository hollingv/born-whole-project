<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Events — {{.SiteName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
    <script src="js/nav.js" defer></script>
    {{template "head-og" .}}
</head>
<body>

    {{template "nav" .}}

    <main class="events-page">
        <h1>Events</h1>
        <p>Upcoming events from organizations working to protect every child's right to bodily autonomy.</p>

        {{if .Events}}
        <h2 class="events-section-heading">Featured Events</h2>
        <table class="events-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Organization</th>
                    <th>Links</th>
                </tr>
            </thead>
            <tbody>
                {{range .Events}}
                <tr>
                    <td class="events-date">{{.Date}}</td>
                    <td>{{.Description}}</td>
                    <td class="events-org">
                        {{with .Org}}{{if .Thumbnail}}
                        <a href="{{.Website}}" target="_blank" title="{{.Name}}">
                            <img src="{{.Thumbnail}}" alt="{{.Name}}" class="events-org-thumbnail" />
                        </a>
                        {{else}}{{.Name}}{{end}}{{end}}
                    </td>
                    <td>{{if .URL}}<a href="{{.URL}}" target="_blank" class="events-link">Learn more</a>{{end}}</td>
                </tr>
                {{end}}
            </tbody>
        </table>
        {{end}}

        {{if .HarvestedEvents}}
        <h2 class="events-section-heading">Tour &amp; Protest Events</h2>
        <p class="events-section-note">Automatically updated from organization websites.</p>
        <table class="events-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Organization</th>
                    <th>Links</th>
                </tr>
            </thead>
            <tbody>
                {{range .HarvestedEvents}}
                <tr>
                    <td class="events-date">{{.Date}}</td>
                    <td>{{.Description}}</td>
                    <td class="events-org">
                        {{with .Org}}{{if .Thumbnail}}
                        <a href="{{.Website}}" target="_blank" title="{{.Name}}">
                            <img src="{{.Thumbnail}}" alt="{{.Name}}" class="events-org-thumbnail" />
                        </a>
                        {{else}}{{.Name}}{{end}}{{end}}
                    </td>
                    <td>{{if .URL}}<a href="{{.URL}}" target="_blank" class="events-link">Learn more</a>{{end}}</td>
                </tr>
                {{end}}
            </tbody>
        </table>
        {{end}}

    </main>

    {{template "footer" .}}

</body>
</html>
