<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.SiteName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
    <script src="js/nav.js" defer></script>
    <script src="js/ask.js" defer></script>
</head>
<body>

    {{template "nav" .}}

    <section class="hero" id="about">
        <div class="hero-text">
            <h1>Connecting People with Resources to Protect Children</h1>
            <p>
                An open, community-maintained resource helping parents, advocates, and communities
                find trusted information and organizations working to end genital cutting of children.
            </p>
            <div class="tagline">Learn. Understand. Take action.</div>
        </div>
        <div class="hero-image">
            <img src="images/HeroImage.webp" alt="Global Autonomy" />
        </div>
    </section>

    <section id="ask" class="ask-section">
        <h2>What do you want to know about?</h2>
        <form class="prompt-form" action="/ask" method="get">
            <div class="prompt-input-wrapper">
                <input type="text" class="prompt-input" name="q" placeholder="What is circumcision?" autocomplete="off" />
                <button type="submit" class="prompt-submit">Ask</button>
            </div>
        </form>
        <div id="ask-response" class="ask-response"></div>
    </section>

    {{template "footer" .}}

</body>
</html>
