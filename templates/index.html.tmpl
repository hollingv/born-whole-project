<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.SiteName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
    <script src="js/nav.js" defer></script>
    <script src="js/ask.js" defer></script>
    {{template "head-og" .}}
</head>
<body class="home-body">

    {{template "nav" .}}

    <div class="home-layout" id="about">

        <div class="home-left">
            <div class="hero-text">
                <h1>{{.SiteName}}</h1>
                <p>Connecting parents, advocates, and the public with the organizations and information working to end forced genital cutting of children. Browse, explore resources, or ask our AI knowledge base a question — grounded in vetted sources, not the open internet.</p>
            </div>
            <div class="hero-image">
                <img src="images/HeroImage.webp" alt="{{.SiteName}}" />
            </div>
        </div>

        <div class="home-middle">
            <h2 class="ask-heading">What question do you have about genital cutting of children?</h2>
            <form class="prompt-form" action="/ask" method="get">
                <div class="prompt-input-wrapper">
                    <input type="text" class="prompt-input" name="q" placeholder="What is genital cutting?" autocomplete="off" />
                </div>
                <button type="submit" class="prompt-submit">Ask the Knowledge Base</button>
            </form>
            <div id="ask-response" class="ask-response"></div>
        </div>

        <div class="home-events">
            <div class="home-events-top">
                <h2 class="home-events-heading">Upcoming Events</h2>
                <a href="events.html" class="home-events-more">View all →</a>
            </div>
            {{if or .Events .HarvestedEvents}}
            <div class="home-events-list">
                {{range .Events}}
                <div class="home-event-item">
                    <div class="home-event-header">
                        <span class="home-event-date">{{.Date}}</span>
                        {{with .Org}}{{if .Thumbnail}}<img src="{{.Thumbnail}}" alt="{{.Name}}" class="home-event-org-img" />{{end}}{{end}}
                    </div>
                    <span class="home-event-desc">{{.Description}}</span>
                    {{if .URL}}<a href="{{.URL}}" target="_blank" class="home-event-link">Learn more</a>{{end}}
                </div>
                {{end}}
                {{range .HarvestedEvents}}
                <div class="home-event-item">
                    <div class="home-event-header">
                        <span class="home-event-date">{{.Date}}</span>
                        {{with .Org}}{{if .Thumbnail}}<img src="{{.Thumbnail}}" alt="{{.Name}}" class="home-event-org-img" />{{end}}{{end}}
                    </div>
                    <span class="home-event-desc">{{.Description}}</span>
                    {{if .URL}}<a href="{{.URL}}" target="_blank" class="home-event-link">Learn more</a>{{end}}
                </div>
                {{end}}
            </div>
            {{else}}
            <p class="home-events-empty">No upcoming events. <a href="events.html">View all events</a>.</p>
            {{end}}
            <a href="events.html" class="home-events-more">View all events →</a>
        </div>

    </div>

    {{template "footer" .}}

</body>
</html>
