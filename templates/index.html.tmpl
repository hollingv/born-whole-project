<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.SiteName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
    <script src="js/nav.js" defer></script>
    <script src="js/ask.js" defer></script>
</head>
<body class="home-body">

    {{template "nav" .}}

    <div class="home-layout" id="about">

        <div class="home-left">
            <div class="hero-text">
                <h1>{{.SiteName}}</h1>
                <p>Central site to direct people to existing websites providing information about the harms of genital cutting and the legal efforts to stop it.</p>
                <p>We are committed to ending the genital cutting of infants and protecting every child's right to bodily autonomy and informed consent.</p>
                <p>Our mission is to provide accurate information, connect people with trusted resources, and support the organizations leading the effort to end this practice.</p>
                <div class="tagline">Learn. Understand. Take action.</div>
            </div>
            <div class="hero-image">
                <img src="images/HeroImage.webp" alt="Bodily Integrity Commons" />
            </div>
        </div>

        <div class="home-right">
            <h2 class="ask-heading">What question do you have about genital cutting of children?</h2>
            <form class="prompt-form" action="/ask" method="get">
                <div class="prompt-input-wrapper">
                    <input type="text" class="prompt-input" name="q" placeholder="What is circumcision?" autocomplete="off" />
                    <button type="submit" class="prompt-submit">Ask</button>
                </div>
            </form>
            <div id="ask-response" class="ask-response"></div>
        </div>

    </div>

    {{template "footer" .}}

</body>
</html>
