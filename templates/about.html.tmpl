<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About — {{.SiteName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
    <script src="js/nav.js" defer></script>
    {{template "head-og" .}}
</head>
<body>

    {{template "nav" .}}

    <main class="mission-page">
        <h1>About {{.SiteName}}</h1>

        <section class="about-mission">
            <h2>Our Mission</h2>
            <p class="about-mission-statement">To protect every child's right to a whole body by connecting parents, doctors, lawyers, advocates, and the public with the knowledge and
            organizations needed to understand, oppose, and ultimately end non-religious genital cutting.</p>
        </section>

        <br>
        <p>{{.SiteName}} is an independent, open-source advocacy resource. We are not affiliated with any single organization — we
        amplify the work of those already engaged in this cause by making knowledge openly accessible and encouraging collaboration
        with accepted open source practices.</p>

    </main>

    {{template "footer" .}}

</body>
</html>
